# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project settings -> Database -> Connection string
# DATABASE_URL: "Transaction pooler" URI (used by the app at runtime)
# DIRECT_URL: "Direct connection" URI (used by Prisma Migrate)
DATABASE_URL=
DIRECT_URL=

# Resend (resend.com) -> API Keys
RESEND_API_KEY=
# Optional: an address on a domain you've verified in Resend. Without this,
# emails send from the shared sandbox domain, which can only reach the email
# your Resend account was signed up with.
RESEND_FROM_EMAIL=
